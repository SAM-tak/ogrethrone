{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "cmake",
      "command": "configure",
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "cmake",
      "command": "build",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "CMake: test",
      "type": "cmake",
      "command": "test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Regenerate samples/basic/lhat-host.json",
      "detail": "Builds the launch target (ogrethrone), then writes the throne host API for the L^ language server.",
      "type": "shell",
      "command": "${command:cmake.launchTargetPath}",
      "args": ["--dump-host-api", "${workspaceFolder}/samples/basic/lhat-host.json"],
      "problemMatcher": []
    }
  ]
}
