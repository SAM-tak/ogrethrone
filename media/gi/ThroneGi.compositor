// Workspaces that render the level from a point into a cubemap, for baking global
// illumination (TDDja/09 9). Both draw render queues below 200 (refractive glass
// needs the viewport's refraction pass; the editor draws the sky in queue 11), then
// queues above 200, with the editor's shadows.

abstract target ThroneGi/CubemapFace
{
	pass render_scene
	{
		load
		{
			all				clear
			clear_colour	0 0 0 1
		}
		store
		{
			depth			store
			stencil			dont_care
		}
		overlays			off
		camera_cubemap_reorient true
		rq_first	0
		rq_last		199
		shadows ThroneEditor/SunShadows recalculate
	}
	pass render_scene
	{
		load
		{
			all		load
		}
		store
		{
			depth			store
			stencil			dont_care
		}
		overlays			off
		camera_cubemap_reorient true
		rq_first	201
		rq_last		249
		shadows ThroneEditor/SunShadows reuse
	}
}

// ThroneGi/CubemapFace with one 2048² map for the sun instead of three cascades (ThroneGi/FastShadows):
// diffuse probes bake faster (GiSettings::fastBakeShadows, TDDja/12 4).
abstract target ThroneGi/CubemapFaceFast
{
	pass render_scene
	{
		load
		{
			all				clear
			clear_colour	0 0 0 1
		}
		store
		{
			depth			store
			stencil			dont_care
		}
		overlays			off
		camera_cubemap_reorient true
		rq_first	0
		rq_last		199
		shadows ThroneGi/FastShadows recalculate
	}
	pass render_scene
	{
		load
		{
			all		load
		}
		store
		{
			depth			store
			stencil			dont_care
		}
		overlays			off
		camera_cubemap_reorient true
		rq_first	201
		rq_last		249
		shadows ThroneGi/FastShadows reuse
	}
}

abstract target ThroneGi/PccDepthCompress
{
	pass render_quad
	{
		store
		{
			depth	dont_care
			stencil	dont_care
		}
		quad_normals	camera_far_corners_view_space
		material		PCC/DepthCompressor
		input			0 depthTexture
		camera_cubemap_reorient true
	}
}

// One parallax-corrected cubemap probe: colour, its compressed depth in alpha, then
// the GGX-prefiltered mipmaps.
compositor_node ThroneGi/ProbeNode
{
	in 0 cubemap
	in 1 ibl_output

	texture depthTexture	target_width target_height PFG_D32_FLOAT

	rtv cubemap_customRtv
	{
		colour	cubemap
		depth	depthTexture
	}
	rtv cubemap_noDepth
	{
		colour		cubemap
		depth_pool	0
	}

	target cubemap_customRtv	+X : ThroneGi/CubemapFace { }
	target cubemap_noDepth		+X : ThroneGi/PccDepthCompress { }
	target cubemap_customRtv	-X : ThroneGi/CubemapFace { }
	target cubemap_noDepth		-X : ThroneGi/PccDepthCompress { }
	target cubemap_customRtv	+Y : ThroneGi/CubemapFace { }
	target cubemap_noDepth		+Y : ThroneGi/PccDepthCompress { }
	target cubemap_customRtv	-Y : ThroneGi/CubemapFace { }
	target cubemap_noDepth		-Y : ThroneGi/PccDepthCompress { }
	target cubemap_customRtv	+Z : ThroneGi/CubemapFace { }
	target cubemap_noDepth		+Z : ThroneGi/PccDepthCompress { }
	target cubemap_customRtv	-Z : ThroneGi/CubemapFace { }
	target cubemap_noDepth		-Z : ThroneGi/PccDepthCompress
	{
		pass ibl_specular
		{
			input cubemap
			output ibl_output
		}
	}
}

workspace ThroneGi/ProbeWorkspace
{
	connect_external 0 ThroneGi/ProbeNode 0
	connect_external 1 ThroneGi/ProbeNode 1
}

// One Adaptive Irradiance Field probe: its colour, which GlobalIllumination reads back and projects to
// spherical harmonics (TDDja/12 4).
compositor_node ThroneGi/AdaptiveNode
{
	in 0 cubemap

	texture depthTexture	target_width target_height PFG_D32_FLOAT

	rtv cubemap_customRtv
	{
		colour	cubemap
		depth	depthTexture
	}

	target cubemap_customRtv	+X : ThroneGi/CubemapFace { }
	target cubemap_customRtv	-X : ThroneGi/CubemapFace { }
	target cubemap_customRtv	+Y : ThroneGi/CubemapFace { }
	target cubemap_customRtv	-Y : ThroneGi/CubemapFace { }
	target cubemap_customRtv	+Z : ThroneGi/CubemapFace { }
	target cubemap_customRtv	-Z : ThroneGi/CubemapFace { }
}

workspace ThroneGi/AdaptiveWorkspace
{
	connect_external 0 ThroneGi/AdaptiveNode 0
}

// ThroneGi/AdaptiveNode with ThroneGi/CubemapFaceFast.
compositor_node ThroneGi/AdaptiveFastNode
{
	in 0 cubemap

	texture depthTexture	target_width target_height PFG_D32_FLOAT

	rtv cubemap_customRtv
	{
		colour	cubemap
		depth	depthTexture
	}

	target cubemap_customRtv	+X : ThroneGi/CubemapFaceFast { }
	target cubemap_customRtv	-X : ThroneGi/CubemapFaceFast { }
	target cubemap_customRtv	+Y : ThroneGi/CubemapFaceFast { }
	target cubemap_customRtv	-Y : ThroneGi/CubemapFaceFast { }
	target cubemap_customRtv	+Z : ThroneGi/CubemapFaceFast { }
	target cubemap_customRtv	-Z : ThroneGi/CubemapFaceFast { }
}

workspace ThroneGi/AdaptiveFastWorkspace
{
	connect_external 0 ThroneGi/AdaptiveFastNode 0
}
