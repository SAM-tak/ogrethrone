// Motion blur of the editor viewport's half-float scene, after temporal anti-aliasing (TDDja/09).
fragment_program Throne/MotionBlur_ps_VK glslvk
{
	source MotionBlur_ps.glsl
	default_params
	{
		param_named shutter float 0
		param_named depthParams float2 0 1
	}
}

fragment_program Throne/MotionTiles_ps_VK glslvk
{
	source MotionTiles_ps.glsl
	default_params
	{
		param_named neighbours float 0
	}
}

// The fastest motion in each 16x16 tile of the velocities.
material Throne/MotionTileMax
{
	technique
	{
		pass
		{
			depth_check off
			depth_write off
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref Throne/MotionTiles_ps_VK
			{
			}

			texture_unit
			{
				filtering none
				tex_address_mode clamp
			}
		}
	}
}

// The fastest motion of the 3x3 tiles around each tile.
material Throne/MotionNeighbourMax : Throne/MotionTileMax
{
	technique
	{
		pass
		{
			fragment_program_ref Throne/MotionTiles_ps_VK
			{
				param_named neighbours float 1
			}
		}
	}
}

material Throne/MotionBlur
{
	technique
	{
		pass
		{
			depth_check off
			depth_write off
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref Throne/MotionBlur_ps_VK
			{
			}

			// The scene, the velocities, the depth and the neighbouring tiles' fastest motion.
			texture_unit
			{
				filtering none
				tex_address_mode clamp
			}
			texture_unit
			{
				filtering none
				tex_address_mode clamp
			}
			texture_unit
			{
				filtering none
				tex_address_mode clamp
			}
			texture_unit
			{
				filtering none
				tex_address_mode clamp
			}
		}
	}
}
