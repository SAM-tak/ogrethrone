// Exposure and tone mapping of the editor viewport's half-float scene.
fragment_program Throne/Tonemap_ps_VK glslvk
{
	source Tonemap_ps.glsl
	default_params
	{
		param_named exposure float 1
		param_named filmic float 0
		param_named bloomStrength float 0.08
	}
}

material Throne/Tonemap
{
	technique
	{
		pass
		{
			depth_check off
			depth_write off
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref Throne/Tonemap_ps_VK
			{
			}

			texture_unit
			{
				filtering none
				tex_address_mode clamp
			}
			texture_unit
			{
				filtering bilinear
				tex_address_mode clamp
			}
		}
	}
}
