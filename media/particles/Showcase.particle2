	// billboard_type		oriented_common
	// common_direction	0 1 0

	// Area emitter
	emitter Point
	{
		position 0 15 -15
		angle 35
		emission_rate 15
		time_to_live 4
		direction 0 1 0
		velocity_min 50
		velocity_max 80
	}

    affector Scaler
    {
		rate 25
    }
}
