{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 / Vulkan",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    },
    {
      "name": "windows-headless",
      "inherits": "windows",
      "displayName": "Windows x64 / CPU smoke checks",
      "cacheVariables": { "THRONE_BUILD_GRAPHICS": "OFF" }
    },
    {
      "name": "linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "linux-headless",
      "inherits": "linux",
      "cacheVariables": { "THRONE_BUILD_GRAPHICS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-headless", "configurePreset": "windows-headless", "configuration": "Debug" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-headless", "configurePreset": "linux-headless" }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-headless", "configurePreset": "windows-headless", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "linux-headless", "configurePreset": "linux-headless", "output": { "outputOnFailure": true } }
  ]
}
